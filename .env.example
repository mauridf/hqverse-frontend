# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:5001
NEXT_PUBLIC_API_BASE_URL=/api

# Authentication
NEXT_PUBLIC_JWT_ACCESS_EXPIRY=7200
NEXT_PUBLIC_JWT_REFRESH_EXPIRY=604800

# Features
NEXT_PUBLIC_ENABLE_DARK_MODE=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Debug
NEXT_PUBLIC_DEBUG_MODE=false

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=HQVerse
NEXT_PUBLIC_SITE_DESCRIPTION=A maior comunidade de HQs digitalizadas

# Environment
NODE_ENV=development